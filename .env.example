# Verdict — environment variables
#
# Copy this file to `.env` and fill in the values. `.env` is git-ignored; never commit it.
#
# ---------------------------------------------------------------------------
# Database (Supabase Postgres, schema owned by Prisma Migrate — spec §6, §7.9)
# ---------------------------------------------------------------------------
# Supabase gives two connection strings and BOTH are needed. Find them in the
# dashboard: Connect (top bar) → ORMs → Prisma. Copy the host exactly as shown
# (newer projects use aws-1-… rather than aws-0-…). Replace [PROJECT_REF], [PASSWORD]
# and [REGION]. If the password contains special characters, URL-encode it
# (e.g. `@` → `%40`, `#` → `%23`).

# 1. Pooled connection — Supavisor transaction mode, port 6543.
#    Used by the app at runtime (Vercel serverless). Keep `?pgbouncer=true&connection_limit=1`:
#    the first disables prepared statements the pooler cannot handle, the second stops
#    every serverless invocation opening its own pool.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# 2. Direct connection — session mode, port 5432. No query parameters.
#    Used ONLY by `prisma migrate` (declared as `directUrl` in prisma/schema.prisma).
#    Migrations fail in confusing ways over the transaction pooler.
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
#    The dedicated host `db.[PROJECT_REF].supabase.co:5432` also works here, but it is
#    IPv6-only unless the project has the IPv4 add-on. The pooler host above works everywhere.

# ---------------------------------------------------------------------------
# Supabase Auth (identity only — never queried for application data, spec §6)
# ---------------------------------------------------------------------------
# Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ---------------------------------------------------------------------------
# Anthropic (server-side only — read by /api/extract-requirements, spec §6)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=""

# ---------------------------------------------------------------------------
# Demo sign-in (spec §12.2). The View demo button signs in with these.
# ---------------------------------------------------------------------------
DEMO_EMAIL="demo@verdict.app"
DEMO_PASSWORD="verdict-demo"
